# Copy to backend/.env and fill in values.
# Optional: backend/.env.local (gitignored) overrides .env for local dev — loaded after .env.

AZURE_API_KEY=
AZURE_OPENAI_BASE_URL=https://<resource>.cognitiveservices.azure.com/openai
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_FILES_API_VERSION=preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.4

# Platform utility model (chat title, compaction). DashScope title calls use enable_thinking=false.
UTILITY_MODEL_API_KEY=
UTILITY_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
UTILITY_MODEL_DEPLOYMENT=qwen3.7-flash

CLAUDE_AZURE_API_KEY=
CLAUDE_AZURE_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/anthropic
# Extended thinking adds load; disable if Azure returns Overloaded / 500
CLAUDE_ENABLE_THINKING=false

# SiliconFlow (OpenAI-compatible — use model_provider: siliconflow in profile.yaml)
# SILICONFLOW_API_KEY=sk-...
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Alibaba DashScope (OpenAI-compatible Chat Completions — qwen, MiniMax/MiniMax-M3, glm-4.7, etc.)
# DASHSCOPE_API_KEY=sk-...
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AUDIO_CAPTURE_MAX_TOTAL_BYTES=83886080
# ASR_PROVIDER=qwen-audio-3.1-asr-flash-filetrans
# ASR_FALLBACK_PROVIDERS=qwen-audio-3.0-asr-flash-filetrans,fun-asr
# ASR_DIARIZATION_ENABLED=true
# ASR_SPEAKER_COUNT=2
# ASR_SIGNED_URL_TTL_SEC=3600
# Thinking/reasoning: OpenAI-compatible extra_body when needed (same pattern as DeepSeek); no special SDK.

# DeepSeek (OpenAI-compatible — use model_provider: deepseek in profile.yaml)
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com

DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Session hot cache (session:{chat_id}); chat transcript is in PostgreSQL. Falls back to chats.session_state when unavailable.
REDIS_URL=redis://default:pass@host:6379

# Fernet key for encrypting MCP credentials at rest (agents/*/mcp_servers.yaml)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_SECRETS_KEY=

# Per-user OAuth MCP integrations (Notion hosted MCP)
# NOTION_MCP_CLIENT_ID=
# NOTION_MCP_CLIENT_SECRET=
# NOTION_MCP_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/notion/callback
# INTEGRATION_SUCCESS_REDIRECT=http://localhost:5173/settings/integrations

# Future: HubSpot remote MCP OAuth (same pattern as ascentium-omni)
# HUBSPOT_MCP_CLIENT_ID=
# HUBSPOT_MCP_CLIENT_SECRET=
# HUBSPOT_MCP_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/hubspot/callback

# Feishu Open Platform (自建应用 App ID / App Secret)
# FEISHU_APP_ID=cli_xxxx
# FEISHU_APP_SECRET=xxxx
# FEISHU_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/feishu/callback
# FEISHU_OAUTH_SCOPE=offline_access im:message:readonly docx:document:readonly calendar:calendar:readonly
# FEISHU_API_BASE=https://open.feishu.cn
# FEISHU_OAUTH_AUTHORIZE_BASE=https://accounts.feishu.cn
# HTTP MCP initialize/list_tools timeout (seconds); Content Studio connects two remote servers
# MCP_HTTP_REQUEST_TIMEOUT=60

# Chat attachments — platform-wide limits (all agents share)
ATTACHMENT_MAX_FILES_PER_MESSAGE=5
ATTACHMENT_MAX_BYTES_PER_FILE=20971520
ATTACHMENT_MAX_TOTAL_BYTES_PER_MESSAGE=52428800
ATTACHMENT_MAX_PAGES_PER_FILE=50
ATTACHMENT_MAX_PAGES_PER_MESSAGE=60
# Still used by current materialize (inline text/sheet truncate) until Hydrate refactor
# ATTACHMENT_EXTRACT_MAX_CHARS_PER_FILE=32000
# ATTACHMENT_EXTRACT_MAX_CHARS_PER_MESSAGE=80000
# ATTACHMENT_TABLE_MAX_ROWS_PER_SHEET=2000
# DOCUMENT_HYDRATE_UNIFIED=false
# HYDRATE_PREVIEW_MAX_BYTES=2048

# Attachment gist (async after parse webhook; DashScope qwen3.7-flash by default)
# ATTACHMENT_GIST_ENABLED=true
# ATTACHMENT_GIST_MODEL=qwen3.7-flash  # gist calls DashScope with enable_thinking=false
# ATTACHMENT_GIST_MODEL_API_KEY=  # defaults to DASHSCOPE_API_KEY
# ATTACHMENT_GIST_MODEL_BASE_URL=  # defaults to DASHSCOPE_BASE_URL
# ATTACHMENT_GIST_TEMPERATURE=0.2
# ATTACHMENT_GIST_MAX_INPUT_CHARS=98304
# ATTACHMENT_GIST_MAX_OUTPUT_TOKENS=2048  # qwen3.x reasoning needs headroom if using Agent path
# HYDRATE_LIBRARY_MAX_ITEMS=20

# Parse pipeline — upload → parse job → webhook → SSE (see parse-pipeline/ for worker)
# Local dev: backend/scripts/setup_parse_inline.sh then run parse-pipeline serve + backend on :8000
# Dispatch modes: service (recommended) | gha | inline (deprecated subprocess)
# auto = gha when GITHUB_* set, else service
# PARSE_PIPELINE_DISPATCH=service
# PARSE_PIPELINE_SERVICE_URL=http://127.0.0.1:8091
# PARSE_PIPELINE_SERVICE_API_KEY=   # match parse-pipeline PARSE_PIPELINE_API_KEYS value
# PARSE_PIPELINE_SERVICE_CALLER_ID=agent-platform
# Backend URL reachable BY parse-pipeline (file I/O + webhooks via /internal/parse/v1/*)
# Local: http://127.0.0.1:8000  |  Production: https://your-backend.example.com
# PARSE_PIPELINE_PUBLIC_BASE_URL=http://127.0.0.1:8000
# PARSE_PIPELINE_WEBHOOK_PATH=/internal/parse/v1/webhook
# PARSE_PIPELINE_RUN_TOKEN_TTL_SEC=7200
# PARSE_PIPELINE_GHA_WATCH_MAX_SEC=5400
# PARSE_PIPELINE_GHA_WATCH_POLL_SEC=20
# PARSE_PIPELINE_JOB_STALE_SEC=7200
# PARSE_PIPELINE_STALE_SWEEP_INTERVAL_SEC=300
# GHA workflow_dispatch (required when PARSE_PIPELINE_DISPATCH=gha or auto with token set)
# GITHUB_TOKEN=ghp_...
# GITHUB_REPO=owner/cow-agent
# GITHUB_WORKFLOW_FILE=parse-pipeline-run-job.yml
# GITHUB_REF=main
#
# NOT in backend/.env (worker-side only):
# - DOCUMENT_MIND_* → GitHub repo secrets (GHA) or parse-pipeline/.env (inline PDF)
# - PARSE_PIPELINE_API_KEYS → parse-pipeline HTTP service only (not used by platform client)
# - PARSE_WEBHOOK_URL/SECRET → legacy manual GHA runs; platform upload uses per-job whsec

# Diagram rendering (agents/napkin-architect)
# PLANTUML_RENDERER=kroki   # kroki (default) or local (requires Java + PLANTUML_JAR_PATH)
KROKI_URL=https://kroki.io
# PLANTUML_JAR_PATH=tools/plantuml.jar
# PLANTUML_RENDER_TIMEOUT_SECONDS=30

# Artifact storage — local disk by default; Vercel requires Blob (see README)
# ARTIFACT_STORAGE=auto          # auto | local | vercel_blob
# BLOB_READ_WRITE_TOKEN=         # set automatically when Blob store is linked to the Vercel project
# BLOB_STORE_ID=                 # optional; parsed from token if omitted
# BLOB_ACCESS=private            # must match your Blob store (private | public)

# Sandbox (content-studio) — E2B docx/pptx/html workspace
# E2B_API_KEY=
# E2B_CONTENT_STUDIO_TEMPLATE=okf-content-studio:1.15
# SANDBOX_TIMEOUT_SECONDS=180
# SANDBOX_REUSE_SESSION=true      # reuse E2B sandbox within one chat run (iterative edits)

# Agent profiles — sync on local backend startup (optional) or via script
# SYNC_AGENT_PROFILES_ON_STARTUP=false   # set true in .env.local for auto-sync on uvicorn start
# After editing backend/agents/* (or if startup sync is off): python scripts/sync_agent_profiles.py

# Referenced from agents/yl-worker1/profile.yaml (mcp-postgres stdio connects to remote DB)
YL_DATABASE_URL=postgresql://user:pass@host/yl_db?sslmode=require
FULFILLMENT_API_BASE_URL=https://yl-backend.evolving.team/api/v1
# FULFILLMENT_API_KEY=

# Hybrid search MCP (agents/content-studio) — endpoint only; each user saves their API key in Integrations
HYBRID_SEARCH_MCP_URL=https://cow-platform-ii.vercel.app/api/mcp/hybrid-search
# Optional OpenKMS HTTP base for listing KBs (defaults to MCP URL without /api/mcp/hybrid-search)
# HYBRID_SEARCH_API_BASE=https://cow-platform-ii.vercel.app

# Zhipu Web Search MCP (agents/content-studio) — endpoint only; each user saves their API key in Integrations
ZHIPU_WEB_SEARCH_MCP_URL=https://open.bigmodel.cn/api/mcp/web_search_prime/mcp



# CORS — comma-separated frontend origins (do NOT quote as JSON unless using [...] array)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://agent-team-frontend-one.vercel.app

# Auth — cookie session
AUTH_DISABLED=false
AUTH_COOKIE_NAME=ap_session
# Production HTTPS: true. Cross-origin frontend (方式 B): AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_TTL_HOURS=168
