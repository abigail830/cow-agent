# Frontend env (Vite). Copy to .env.local for local overrides.
#
# --- 方式 A（推荐 / 默认）：同源 /api，由 Vite 或 frontend/vercel.json rewrite 代理 ---
# 不要依赖 VITE_API_BASE_URL。代码默认忽略该变量，避免自定义域名上下载 PPT/Word 触发 CORS。
# VITE_API_BASE_URL=
#
# --- 方式 B：跨域直连（需后端 CORS_ORIGINS + AUTH_COOKIE_SAMESITE=none）---
# VITE_API_FORCE_ABSOLUTE=1
# VITE_API_BASE_URL=https://cow-agent.vercel.app
