# Job state: memory (default, in-process) | none (alias) | postgres (optional profile B)
JOB_STORE=memory

# Only when JOB_STORE=postgres
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/agent_platform

# Service auth: caller_id:api_key pairs, comma-separated
PARSE_PIPELINE_API_KEYS=agent-platform:psk_parse_change_me,test:test_key_change_me

# Document Mind (Alibaba Cloud)
DOCUMENT_MIND_ACCESS_KEY_ID=
DOCUMENT_MIND_ACCESS_KEY_SECRET=
DOCUMENT_MIND_ENDPOINT=docmind-api.cn-hangzhou.aliyuncs.com
DOCUMENT_MIND_LLM_ENHANCEMENT=true
DOCUMENT_MIND_ENHANCEMENT_MODE=VLM
DOCUMENT_MIND_POLL_INTERVAL_SEC=5
DOCUMENT_MIND_LAYOUT_STEP_SIZE=50

# Office .docx: local markitdown + quality gate (fallback Document Mind when false or gate fails)
OFFICE_MARKITDOWN_ENABLED=true

# DashScope ASR (audio_transcription_standard pipeline)
# DASHSCOPE_API_KEY=sk-...
# ASR_PROVIDER=qwen3-asr-flash-filetrans
# ASR_FALLBACK_PROVIDER=fun-asr
# ASR_POLL_INTERVAL_SEC=5
# ASR_POLL_TIMEOUT_SEC=7200

# Outbound webhook delivery to platform (retries after first failure)
WEBHOOK_MAX_RETRIES=1
WEBHOOK_TIMEOUT_SEC=10

HOST=0.0.0.0
PORT=8091
LOG_LEVEL=INFO
